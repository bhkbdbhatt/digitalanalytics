# All paths can be absolute paths or relative to the base folder of the repo ENV_CONFIG_PATH=.\configs\prod.yml

# ADDITIONAL_CONFIGS & SECRETS_FILES are semicolon seprated list.

# Note that the list is loaded sequencially and the later list would override earlier ones in case of conf ADDITIONAL_CONFIGS=.\additionalcohfigs\rpenroll.common.yml;.\additionalconfigs\rpenroll.prod.yml; # SECRETFILES=.\additionalconfigs\sample.secrets.yml

# All strings in the environment variables that start with 'DAT_'add/override

# the configurations from within settings folder

# for example: DAT_browserSettings_chromepath would be override chromepath in browserSettings.yml file DAT_browserSettings_chromepath=C:\Program Files (x86)\Google\Chrome\Application\chrome.exe

DAT_browserSettings_headless=false

DAT_browserSettings_slowmo=1000 DAT_browserSettings_width=1364

DAT_browserSettings_height=1024

DAT_browserSettings_takesnapshots=true

DAT_browserSettings_networkidle=networkidle2
DAT_browserSettings_networkwaittime=30000

DAT_cucumberSettings_defaultTimeoutForStep=60000

DAT_loggerSettings_loggerlevel=debug

DAT_loggerSettings_loggerlevelverbosetrace=false