{
  "name": "digitalanalytics",
  "version": "1.0.0",
  "description": "This is a digitalanalyticstesting project.",
  "main": "no",
  "author": "INYBDB",
  "license": "ISC",
  "dependencies": {
    "@cucumber/cucumber": "^10.8.0",
    "command-line-args": "^5.2.1",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0",
    "log4js": "^6.9.1",
    "puppeteer-core": "^22.10.0"
  },
  "devDependencies": {
    "allure-commandline": "^2.29.0"
  },
  "scripts":{
    "test":"cucumber-js -f json:./report/cucumber.json -f junit:./report/cucumber-junit.xml -f html:./report/cucumber.html",
    "demo":"cucumber-js -f json:./report/cucumber.json -f junit:./report/cucumber-junit.xml -f html:./report/cucumber.html -t @demo",
    "dryrun":"cucumber-js --dry-run",
    "lint":"node tools/syntaxcheck.js",
    "check":"npm run lint && npm run dryrun",
    "allure:generate":"npx allure generate report --clean -o ./report/allure-report",
    "allure:open":"npx allure open ./report/allure-report"
  },
  "keywords":[
    "cucumber",
    "puppeteer",
    "digital",
    "analytics",
    "disclosure"
  ]
}
